{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FieldMatches",
  "description": "Cross-regime field matches with how they differ, and a DRAFT view of whether harmonizing would change what firms must report. The human effect classification in Refactor remains the decision (PRD NG2).",
  "type": "object",
  "required": ["matches"],
  "properties": {
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["a", "b", "aspects"],
        "properties": {
          "a": { "type": "string" },
          "b": { "type": "string" },
          "aspects": {
            "type": "array", "minItems": 1,
            "items": { "enum": ["identical", "format_difference", "definition_difference", "validation_conflict", "applicability_difference"] }
          },
          "detail": { "type": "string" },
          "changes_obligations": { "type": "boolean" },
          "impact_reason": { "type": "string" }
        }
      }
    }
  }
}

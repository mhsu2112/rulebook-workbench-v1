{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FieldExtraction",
  "description": "Reporting fields read from a legal text's field tables. Each carries a verbatim quote that code checks against the source; unverified fields are dropped.",
  "type": "object",
  "required": ["fields"],
  "properties": {
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "quote"],
        "properties": {
          "number": { "type": ["string", "integer", "null"] },
          "name": { "type": "string" },
          "definition": { "type": ["string", "null"] },
          "format": { "type": ["string", "null"] },
          "quote": { "type": "string" }
        }
      }
    }
  }
}

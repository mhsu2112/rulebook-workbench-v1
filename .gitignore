# Secrets — never commit
.env
**/.env

# Restricted per-program stores (transcripts, interview data)
**/restricted/
programs/*/restricted/

# Worked examples not published in this repo.
# The repo ships the workbench design; the AML refactor and liquidity
# redesign (p1/p2) programs are the illustrative examples. These two stay
# local so the mirror does not re-add them.
workbench-app/programs/government-sponsored-lending/
workbench-app/programs/uk-derivatives-reporting/

# Python
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# OS cruft
.DS_Store

# Local-only: historical snapshots, share packages, legacy git bundles.
# Large and rebuildable; see docs/README.md.
docs/archive/
docs/uk-derivatives-reporting-derived.html

# Archived program experiments (local only)
workbench-app/programs/_archive/

# Stray editor/backup files
*.bak

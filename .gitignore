# Secrets — never commit
.env
**/.env

# ---------------------------------------------------------------------------
# WORKING DATA NEVER LIVES IN THIS REPO.
# Programs, the run log (runs/stamps.jsonl) and exports live in the data
# folder OUTSIDE the repo (default: ../workbench-data; see
# workbench-app/src/workbench/datadir.py). The only programs published here are
# the examples in examples/, updated deliberately with `make publish-examples`.
# The rules below are a second line of defence if anything lands here anyway.
# ---------------------------------------------------------------------------
workbench-app/programs/
workbench-app/runs/
workbench-data/
exports/
workbench-share-*.zip

# Restricted per-program stores (transcripts, interview data) — anywhere
**/restricted/
# Exploration branches are working material, not published examples
examples/*/explorations/

# Python
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# OS cruft
.DS_Store

# Local-only historical material (moved to the data folder's archive/)
docs/archive/

# Stray editor/backup files
*.bak

# Local Claude Code settings
.claude/settings.local.json
